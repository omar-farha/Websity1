# Copy this file to .env.local and fill in your Supabase project's values.
# Find these under Project Settings -> API in your Supabase dashboard.
# These are safe to expose to the browser (NEXT_PUBLIC_*) — access to real
# data is controlled by Row Level Security policies, not by keeping this secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role / secret key — server-only, bypasses Row Level Security.
# Used by the dashboard (clients, transactions, content editing) since the
# dashboard's own password login has no Supabase session to satisfy the
# "auth.uid() is not null" RLS policies. NEVER prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dashboard login (password-only, no Supabase account needed).
# DASHBOARD_PASSWORD: pick any password — this is the only login credential.
# DASHBOARD_SESSION_SECRET: a random string used to sign the session cookie.
#   Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Neither of these should ever start with NEXT_PUBLIC_ — they must stay server-only.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
